# ============================================================
# Nityasādhanā — Backend Environment Configuration (FastAPI / Render)
# ============================================================
# Copy this file to backend/.env for local FastAPI development.
# For Render deployment, configure these variables in:
# Render Dashboard -> Web Service -> Environment Variables
#
# NOTE: Secrets here must remain strictly private on the backend host.
# NEVER prefix backend variables with NEXT_PUBLIC_ or expose to frontend.
# ============================================================

# ------------------------------------------------------------
# REQUIRED FOR PRODUCTION
# ------------------------------------------------------------

# Database connection URL
# Local development default: sqlite:///./test.db (points to test.db at repository root)
# Render Production: postgresql://<user>:<password>@<host>/<dbname>
# NOTE: Render free-tier instances use ephemeral disk storage.
# For persistent production data, use a managed PostgreSQL database.
DATABASE_URL=sqlite:///./test.db

# Cryptographic signing secret for JWT access tokens (session cookie)
# Generate a strong 64-character random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret-in-production

# JWT signature algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in minutes (default: 60)
ACCESS_TOKEN_MINUTES=60

# Allowed CORS origins (comma-separated list of browser origins)
# Local: http://localhost:3000,http://127.0.0.1:3000
# Render Production: http://localhost:3000,http://127.0.0.1:3000,https://nityasadhanaiskon.vercel.app
# Do NOT use a wildcard ("*") when credentials/cookies are included.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nityasadhanaiskon.vercel.app

# Base URL of the Next.js frontend (used to construct password-reset links sent by email)
# Local: http://localhost:3000
# Render Production: https://nityasadhanaiskon.vercel.app
FRONTEND_URL=https://nityasadhanaiskon.vercel.app

# ------------------------------------------------------------
# OPTIONAL CONFIGURATION
# ------------------------------------------------------------

# FastAPI Application title (default: Nityasadhana API)
APP_NAME=Nityasadhana API

# Backend environment ("development" | "staging" | "production")
ENVIRONMENT=development

# ------------------------------------------------------------
# SMTP / EMAIL CONFIGURATION (Optional: for password reset emails)
# If left empty, email sending is skipped without failing.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
