# ============================================================
# Nityasādhanā — Frontend Environment Configuration (Vercel / Local)
# ============================================================
# Copy this file to .env.local for local Next.js development.
# For Vercel production deployment, configure these variables in:
# Project Settings -> Environment Variables
#
# NOTE: Backend (FastAPI / Render) configuration is separated into
# backend/.env.example. NEVER put backend secrets, database URLs,
# or JWT keys into frontend environment files.
# ============================================================

# ------------------------------------------------------------
# PUBLIC VARIABLES (Exposed to browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------

# Public URL of the frontend application
# Local: http://localhost:3000
# Vercel Production: https://<your-vercel-app>.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application display name
NEXT_PUBLIC_APP_NAME=Nityasādhanā

# Application environment ("development" | "staging" | "production")
# In production, this prevents development mock data and test seeding
NEXT_PUBLIC_APP_ENV=development

# Base URL of the FastAPI backend service
# Local: http://localhost:8000
# Vercel Production: https://<your-render-service>.onrender.com (or custom API domain)
# IMPORTANT: Must NOT end with a trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

